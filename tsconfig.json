{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/theme": ["theme/index.ts"],
      "@/theme/*": ["theme/*"],
      "@/assets/*": ["assets/*"],
      "@/data/*": ["src/data/*"],
      "@/components/*": ["src/components/*"],
      "@/app/*": ["app/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app",
    "theme",
    "src"
  ]
}